rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rooms: Anyone authenticated can read, only admins (or specific logic) can create/update
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated(); // Simplified for this exercise

      // Messages sub-collection
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time; // serverTimestamp() enforcement

        allow update, delete: if isAuthenticated() && isOwner(resource.data.senderId);
      }
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwner(userId);
    }
  }
}
